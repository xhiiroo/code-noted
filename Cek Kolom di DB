-- Mencari Kolom di Semua Database pada 1 Server
SELECT TABLE_SCHEMA, TABLE_NAME, COLUMN_NAME 
FROM information_schema.COLUMNS 
WHERE COLUMN_NAME = 'areacode';

-- Mencari Kolom dalam Database Tertentu
SELECT TABLE_NAME, COLUMN_NAME 
FROM information_schema.COLUMNS 
WHERE TABLE_SCHEMA = 'bm' 
AND COLUMN_NAME = 'areacode';
