CREATE TABLE `tmp_coba`.test1233
SELECT * FROM (
    SELECT 
        k.becreff,
        k.staffid, 
        k.nobukti,
				k.TglBukti,
				k.dbowner AS user_create, 
        v.sourceid, 
        MAX(c.name) AS name,
        SUM(v.amount) AS amount,
				SUM(v.paid) AS paid
    FROM draftinv v
    LEFT JOIN kasbank k ON k.becreff = v.becreff
    LEFT JOIN customer c ON c.id = v.sourceid
    WHERE k.tglbukti BETWEEN '2024-01-01' AND CURDATE()
-- 		and k.staffid = 12 -- Aktifkan untuk filter sales tertentu
    GROUP BY v.sourceid, k.nobukti
) AS subquery;

CREATE TABLE `tmp_coba`.test1234
select * from (
select o.becreff, o.custid, k.nobukti, SUM(o.nilaigiro) as giro from draftgiro o left join kasbank k on k.becreff = o.becreff 
where k.tglbukti between '2024-01-01' and CURDATE() 
-- and k.staffid = 12 -- Aktifkan untuk filter sales tertentu
group by o.custid, k.nobukti
) as subquery;

CREATE TABLE `tmp_coba`.test1235
select * from (
select m.becreff, m.custid, k.nobukti, SUM(m.jumlah) as tfbank from kasbankitem m left join kasbank k on k.becreff = m.becreff 
where m.tipe=2 and k.tglbukti between '2024-01-01' and CURDATE()
-- and k.staffid = 12 -- Aktifkan untuk filter sales tertentu
group by m.custid, k.nobukti
order by k.nobukti, m.custid
) as subquery;

SELECT a.*, b.giro, c.tfbank 
FROM `tmp_coba`.test1233 a
