SELECT 
    k.becreff,
    k.staffid, 
    k.nobukti,
		k.TglBukti,
		k.dbowner AS user_create, 
    v.sourceid, 
    MAX(cust.name) AS name,
    SUM(v.amount) AS amount,
		SUM(v.paid) AS paid,
    b.giro,
    tf.tfbank
FROM draftinv v
LEFT JOIN kasbank k 
    ON k.becreff = v.becreff
LEFT JOIN customer cust
    ON cust.id = v.sourceid
LEFT JOIN (
    SELECT o.becreff, o.custid, k.nobukti, SUM(o.nilaigiro) AS giro
    FROM draftgiro o 
    LEFT JOIN kasbank k 
        ON k.becreff = o.becreff 
    WHERE 
-- 				k.staffid = 12 and -- Aktifkan untuk filter sales tertentu
        k.tglbukti BETWEEN '2024-01-01' AND CURDATE()
    GROUP BY o.custid, k.nobukti, o.becreff
) b 
    ON b.becreff = k.becreff 
    AND b.nobukti = k.nobukti
    AND b.custid = v.sourceid
LEFT JOIN (
    SELECT m.becreff, m.custid, k.nobukti, SUM(m.jumlah) AS tfbank 
    FROM kasbankitem m 
    LEFT JOIN kasbank k 
        ON k.becreff = m.becreff 
    WHERE m.tipe = 2 
--         AND k.staffid = 12 -- Aktifkan untuk filter sales tertentu
        AND k.tglbukti BETWEEN '2024-01-01' AND CURDATE()
    GROUP BY m.custid, k.nobukti, m.becreff
) tf  
    ON tf.becreff = k.becreff 
    AND tf.nobukti = k.nobukti
    AND tf.custid = v.sourceid
WHERE 
-- 		k.staffid = 12 and -- Aktifkan untuk filter sales tertentu
    k.tglbukti BETWEEN '2024-01-01' AND CURDATE()
GROUP BY v.sourceid, k.nobukti
order by k.tglbukti;


