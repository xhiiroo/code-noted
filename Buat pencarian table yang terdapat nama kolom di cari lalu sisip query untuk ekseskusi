select concat(
    'alter table `', table_name, '` ',
    group_concat(
        concat('drop column `', column_name, '`')
        separator ', '
    ),
    ';'
) as sql_script
from information_schema.columns
where table_schema = database()
  and column_name in ('usrowner', 'usredit')
group by table_name
order by table_name;
